# ---- Login "administrator" (pemilik toko) ----
# Akun tunggal pemilik toko, akses penuh. Akun "admin" tambahan (banyak orang
# bisa daftar sendiri lewat halaman /admin/register) TIDAK pakai env ini —
# datanya otomatis tersimpan di tab `Admins` pada Google Sheet kamu.
ADMIN_EMAIL=lumenrobbin@gmail.com
ADMIN_PASSWORD=gantidenganpasswordkuat

# String acak panjang untuk menandatangani sesi login (boleh generate lewat
# https://generate-secret.vercel.app/32 atau `openssl rand -hex 32`)
SESSION_SECRET=

# ---- Google Sheets (dipakai sebagai "database") ----
# Email service account dari Google Cloud, contoh:
# mamahepi-bot@nama-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Private key dari file JSON service account (bagian "private_key").
# Simpan sebagai satu baris, ganti setiap baris baru dengan \n
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ID Google Sheet (lihat di URL sheet: docs.google.com/spreadsheets/d/<ID_INI>/edit)
GOOGLE_SHEET_ID=1dk7R9MtTr5ktiuuyQUqx-TOc0sT-SJq96bmljJeNGoE

# ---- Email notifikasi pesanan baru & kode reset password admin ----
# Contoh pakai Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465,
# SMTP_USER=email gmail kamu, SMTP_PASS=App Password (bukan password biasa)
# SMTP ini juga dipakai untuk mengirim kode OTP 6 digit saat admin lupa
# password — jadi wajib diisi kalau mau fitur "Lupa password" jalan.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# ---- (Opsional) Notifikasi WhatsApp OTOMATIS ke pemilik toko lewat Fonnte ----
# Kosongkan kalau belum mau pakai — email di atas sudah cukup untuk notifikasi.
# Daftar & dapatkan token di https://fonnte.com (perangkat WA sendiri, murah/pay-as-you-go).
FONNTE_TOKEN=
